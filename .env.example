# Alternative: GTM owns every tag. Leave ALL direct IDs above empty.
GTM_CONTAINER_ID=
# Comma-separated providers actually published in the container:
# ga4,meta,googleAds,linkedin,tiktok
GTM_SERVICES=
MEASUREMENT_DEBUG=false
